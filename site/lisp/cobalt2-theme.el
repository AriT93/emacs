;;; cobalt2-theme.el --- Port of Wes Bos's Cobalt2 theme -*- lexical-binding: t; -*-

;;; Commentary:
;; Colors taken from the official cobalt2 VS Code theme
;; (github.com/wesbos/cobalt2-vscode, theme/cobalt2.json).
;; Load with: (load-theme 'cobalt2 t)

;;; Code:

(deftheme cobalt2 "Wes Bos's Cobalt2, ported from the VS Code theme.")

(let* ((bg        "#193549")
       (bg-dark   "#15232d")
       (bg-darker "#122738")
       (bg-hl     "#1f4662")
       (bg-match  "#0d3a58")
       (region    "#0050a4")
       (guide     "#3b5364")
       (fg        "#ffffff")
       (fg-soft   "#e1efff")
       (fg-dim    "#aaaaaa")
       (yellow    "#ffc600")
       (yellow-lt "#ffee80")
       (orange    "#ff9d00")
       (orange-lt "#ffb454")
       (pink      "#ff628c")
       (red       "#ff0088")
       (err       "#f44542")
       (green     "#3ad900")
       (green-lt  "#a5ff90")
       (mint      "#80ffbb")
       (blue      "#0088ff")
       (cyan      "#9effff")
       (magenta   "#fb94ff"))
  (custom-theme-set-faces
   'cobalt2
   ;; Basics
   `(default ((t (:background ,bg :foreground ,fg))))
   `(cursor ((t (:background ,yellow))))
   `(region ((t (:background ,region :extend t))))
   `(secondary-selection ((t (:background ,bg-match))))
   `(highlight ((t (:background ,bg-hl))))
   `(hl-line ((t (:background ,bg-hl :extend t))))
   `(fringe ((t (:background ,bg :foreground ,fg-dim))))
   `(vertical-border ((t (:foreground ,bg-dark))))
   `(border ((t (:background ,bg-dark))))
   `(shadow ((t (:foreground ,fg-dim))))
   `(link ((t (:foreground ,cyan :underline t))))
   `(link-visited ((t (:foreground ,magenta :underline t))))
   `(match ((t (:background "#ff720066" :foreground ,fg))))
   `(lazy-highlight ((t (:background "#cad40f66" :foreground ,fg))))
   `(isearch ((t (:background "#ff720099" :foreground ,fg :weight bold))))
   `(isearch-fail ((t (:background ,err :foreground ,fg))))
   `(show-paren-match ((t (:background ,bg-match :foreground ,yellow :weight bold))))
   `(show-paren-mismatch ((t (:background ,err :foreground ,fg))))
   `(trailing-whitespace ((t (:background "#ee3a4366"))))
   `(escape-glyph ((t (:foreground ,orange))))
   `(minibuffer-prompt ((t (:foreground ,yellow :weight bold))))
   `(error ((t (:foreground ,err :weight bold))))
   `(warning ((t (:foreground ,yellow :weight bold))))
   `(success ((t (:foreground ,green :weight bold))))
   `(line-number ((t (:background ,bg :foreground ,fg-dim))))
   `(line-number-current-line ((t (:background ,bg-hl :foreground ,yellow))))
   `(header-line ((t (:background ,bg-dark :foreground ,fg-dim))))
   `(tooltip ((t (:background ,bg-dark :foreground ,fg))))
   ;; Mode line
   `(mode-line ((t (:background ,bg-dark :foreground ,fg-dim :box nil))))
   `(mode-line-inactive ((t (:background ,bg-darker :foreground "#5f7a8c" :box nil))))
   `(mode-line-emphasis ((t (:foreground ,yellow :weight bold))))
   `(mode-line-buffer-id ((t (:foreground ,yellow :weight bold))))
   ;; Font lock
   `(font-lock-comment-face ((t (:foreground ,blue :slant italic))))
   `(font-lock-comment-delimiter-face ((t (:foreground ,blue :slant italic))))
   `(font-lock-doc-face ((t (:foreground ,blue :slant italic))))
   `(font-lock-string-face ((t (:foreground ,green-lt))))
   `(font-lock-keyword-face ((t (:foreground ,orange))))
   `(font-lock-builtin-face ((t (:foreground ,orange))))
   `(font-lock-function-name-face ((t (:foreground ,yellow))))
   `(font-lock-function-call-face ((t (:foreground ,yellow))))
   `(font-lock-variable-name-face ((t (:foreground ,fg-soft))))
   `(font-lock-variable-use-face ((t (:foreground ,fg-soft))))
   `(font-lock-type-face ((t (:foreground ,mint))))
   `(font-lock-constant-face ((t (:foreground ,pink))))
   `(font-lock-number-face ((t (:foreground ,pink))))
   `(font-lock-preprocessor-face ((t (:foreground ,orange))))
   `(font-lock-negation-char-face ((t (:foreground ,orange))))
   `(font-lock-warning-face ((t (:foreground ,err :weight bold))))
   `(font-lock-regexp-grouping-backslash ((t (:foreground ,orange))))
   `(font-lock-regexp-grouping-construct ((t (:foreground ,yellow))))
   `(font-lock-punctuation-face ((t (:foreground ,fg-soft))))
   `(font-lock-bracket-face ((t (:foreground ,fg-soft))))
   `(font-lock-property-name-face ((t (:foreground ,cyan))))
   `(font-lock-property-use-face ((t (:foreground ,cyan))))
   ;; Org
   `(org-level-1 ((t (:foreground ,yellow :weight bold))))
   `(org-level-2 ((t (:foreground ,orange :weight bold))))
   `(org-level-3 ((t (:foreground ,mint :weight bold))))
   `(org-level-4 ((t (:foreground ,magenta :weight bold))))
   `(org-level-5 ((t (:foreground ,cyan))))
   `(org-level-6 ((t (:foreground ,green-lt))))
   `(org-level-7 ((t (:foreground ,pink))))
   `(org-level-8 ((t (:foreground ,yellow-lt))))
   `(org-document-title ((t (:foreground ,yellow :weight bold))))
   `(org-document-info ((t (:foreground ,cyan))))
   `(org-document-info-keyword ((t (:foreground ,blue))))
   `(org-meta-line ((t (:foreground ,blue :slant italic))))
   `(org-todo ((t (:foreground ,pink :weight bold))))
   `(org-done ((t (:foreground ,green :weight bold))))
   `(org-headline-done ((t (:foreground ,fg-dim))))
   `(org-date ((t (:foreground ,cyan :underline t))))
   `(org-link ((t (:foreground ,cyan :underline t))))
   `(org-tag ((t (:foreground ,orange-lt :weight normal))))
   `(org-code ((t (:foreground ,cyan))))
   `(org-verbatim ((t (:foreground ,green-lt))))
   `(org-block ((t (:background ,bg-dark :foreground ,fg-soft :extend t))))
   `(org-block-begin-line ((t (:background ,bg-darker :foreground ,blue :extend t))))
   `(org-block-end-line ((t (:background ,bg-darker :foreground ,blue :extend t))))
   `(org-table ((t (:foreground ,cyan))))
   `(org-special-keyword ((t (:foreground ,blue))))
   `(org-drawer ((t (:foreground ,blue))))
   `(org-checkbox ((t (:foreground ,yellow :weight bold))))
   `(org-formula ((t (:foreground ,pink))))
   ;; Markdown
   `(markdown-code-face ((t (:foreground ,cyan))))
   `(markdown-inline-code-face ((t (:foreground ,cyan))))
   `(markdown-url-face ((t (:foreground ,cyan))))
   `(markdown-link-face ((t (:foreground ,green-lt))))
   `(markdown-list-face ((t (:foreground ,yellow))))
   `(markdown-blockquote-face ((t (:foreground ,cyan :slant italic))))
   `(markdown-bold-face ((t (:foreground ,cyan :weight bold))))
   `(markdown-italic-face ((t (:foreground ,cyan :slant italic))))
   ;; Completion / minibuffer (vertico, consult, orderless)
   `(completions-common-part ((t (:foreground ,yellow))))
   `(completions-first-difference ((t (:foreground ,orange :weight bold))))
   `(vertico-current ((t (:background ,bg-hl :extend t))))
   `(orderless-match-face-0 ((t (:foreground ,yellow :weight bold))))
   `(orderless-match-face-1 ((t (:foreground ,mint :weight bold))))
   `(orderless-match-face-2 ((t (:foreground ,magenta :weight bold))))
   `(orderless-match-face-3 ((t (:foreground ,orange :weight bold))))
   `(consult-highlight-match ((t (:background ,bg-match :foreground ,yellow))))
   `(consult-highlight-mark ((t (:background ,bg-match :foreground ,yellow))))
   ;; Diffs and magit
   `(diff-added ((t (:background "#3ad90033" :foreground ,green-lt))))
   `(diff-removed ((t (:background "#ee3a4333" :foreground ,pink))))
   `(diff-changed ((t (:background "#ffc60026" :foreground ,yellow))))
   `(diff-refine-added ((t (:background "#3ad90066"))))
   `(diff-refine-removed ((t (:background "#ee3a4366"))))
   `(diff-header ((t (:background ,bg-dark :foreground ,cyan))))
   `(diff-file-header ((t (:background ,bg-dark :foreground ,yellow :weight bold))))
   `(diff-hunk-header ((t (:background ,bg-dark :foreground ,magenta))))
   `(magit-section-heading ((t (:foreground ,yellow :weight bold))))
   `(magit-section-highlight ((t (:background ,bg-hl :extend t))))
   `(magit-branch-local ((t (:foreground ,cyan))))
   `(magit-branch-remote ((t (:foreground ,green-lt))))
   `(magit-diff-added ((t (:background "#3ad90033" :foreground ,green-lt))))
   `(magit-diff-added-highlight ((t (:background "#3ad90044" :foreground ,green-lt))))
   `(magit-diff-removed ((t (:background "#ee3a4333" :foreground ,pink))))
   `(magit-diff-removed-highlight ((t (:background "#ee3a4344" :foreground ,pink))))
   `(magit-diff-hunk-heading ((t (:background ,bg-dark :foreground ,magenta))))
   `(magit-diff-hunk-heading-highlight ((t (:background ,bg-hl :foreground ,magenta))))
   `(magit-hash ((t (:foreground ,fg-dim))))
   ;; Flymake / flycheck
   `(flymake-error ((t (:underline (:style wave :color ,err)))))
   `(flymake-warning ((t (:underline (:style wave :color ,yellow)))))
   `(flymake-note ((t (:underline (:style wave :color ,green)))))
   `(flycheck-error ((t (:underline (:style wave :color ,err)))))
   `(flycheck-warning ((t (:underline (:style wave :color ,yellow)))))
   `(flycheck-info ((t (:underline (:style wave :color ,green)))))
   ;; Rainbow delimiters
   `(rainbow-delimiters-depth-1-face ((t (:foreground ,yellow))))
   `(rainbow-delimiters-depth-2-face ((t (:foreground ,magenta))))
   `(rainbow-delimiters-depth-3-face ((t (:foreground ,mint))))
   `(rainbow-delimiters-depth-4-face ((t (:foreground ,orange))))
   `(rainbow-delimiters-depth-5-face ((t (:foreground ,cyan))))
   `(rainbow-delimiters-depth-6-face ((t (:foreground ,pink))))
   `(rainbow-delimiters-depth-7-face ((t (:foreground ,green-lt))))
   `(rainbow-delimiters-depth-8-face ((t (:foreground ,blue))))
   `(rainbow-delimiters-depth-9-face ((t (:foreground ,yellow-lt))))
   `(rainbow-delimiters-unmatched-face ((t (:foreground ,err :weight bold))))
   ;; Misc
   `(which-key-key-face ((t (:foreground ,yellow))))
   `(which-key-command-description-face ((t (:foreground ,fg-soft))))
   `(treemacs-root-face ((t (:foreground ,yellow :weight bold))))
   `(treemacs-directory-face ((t (:foreground ,cyan))))
   `(doom-modeline-bar ((t (:background ,yellow))))
   `(doom-modeline-buffer-file ((t (:foreground ,fg))))
   `(doom-modeline-buffer-modified ((t (:foreground ,pink :weight bold))))
   `(web-mode-html-tag-face ((t (:foreground ,cyan))))
   `(web-mode-html-attr-name-face ((t (:foreground ,yellow :slant italic))))
   `(web-mode-html-attr-value-face ((t (:foreground ,green-lt))))
   `(web-mode-css-property-name-face ((t (:foreground ,green))))
   `(js2-function-param ((t (:foreground ,magenta))))
   `(js2-external-variable ((t (:foreground ,pink))))))

(custom-theme-set-variables
 'cobalt2
 '(ansi-color-names-vector
   ["#122738" "#ff628c" "#3ad900" "#ffc600" "#0088ff" "#fb94ff" "#80fcff" "#ffffff"]))

;;;###autoload
(when load-file-name
  (add-to-list 'custom-theme-load-path
               (file-name-as-directory (file-name-directory load-file-name))))

(provide-theme 'cobalt2)

;;; cobalt2-theme.el ends here
